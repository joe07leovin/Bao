# Reference only; the executable does not automatically load dotenv files.
# Supply every value through your environment or secret manager.
BAO_LISTEN_ADDRESS=localhost:8443
BAO_TLS_CERT_FILE=
BAO_TLS_KEY_FILE=
# Use a real host matching the server certificate and a trusted CA.
BAO_DATABASE_URL=
# Example operational settings, not business-policy defaults.
BAO_DATABASE_MAX_CONNECTIONS=5
BAO_DATABASE_CONNECT_TIMEOUT=10s
BAO_HTTP_READ_HEADER_TIMEOUT=5s
BAO_HTTP_READ_TIMEOUT=15s
BAO_HTTP_WRITE_TIMEOUT=15s
BAO_HTTP_IDLE_TIMEOUT=60s
BAO_HTTP_MAX_HEADER_BYTES=16384
BAO_HEALTH_TIMEOUT=2s
BAO_SHUTDOWN_TIMEOUT=10s
